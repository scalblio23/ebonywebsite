# Copy this file to .env for local testing (never commit .env).
# In production, add these in Vercel → Project → Settings → Environment Variables.

# Required: your Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the sender. Defaults to the placeholder in api/_lib/email.js.
# Until your domain is verified in Resend you can use: Ceramics Class <onboarding@resend.dev>
# EMAIL_FROM=Ceramics Class <bookings@YOURDOMAIN.com>

# Optional: where enquiry notifications are delivered. Defaults to studio@ebonyfortunatow.com.
# ENQUIRY_NOTIFY_TO=studio@ebonyfortunatow.com
